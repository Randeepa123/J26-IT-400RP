{
  "uid": "grid-live-drift",
  "title": "Grid \u00b7 Synthetic Live Drift & Adaptation",
  "tags": [
    "synthetic",
    "ADWIN",
    "Ridge",
    "live-demo"
  ],
  "schemaVersion": 40,
  "version": 3,
  "timezone": "Asia/Colombo",
  "editable": false,
  "refresh": "3s",
  "time": {
    "from": "now-15m",
    "to": "now"
